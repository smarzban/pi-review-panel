{
	"name": "pi-review-panel",
	"version": "0.1.0",
	"description": "Multi-model review panel for pi coding agents",
	"keywords": [
		"pi-package"
	],
	"type": "module",
	"engines": {
		"node": ">=26.0.0"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"check": "biome check ."
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "^0.84.1",
		"typebox": "*"
	},
	"files": [
		"src",
		"prompts",
		"skills",
		"docs/configuration.md"
	],
	"pi": {
		"extensions": [
			"src/tool/review-panel.ts"
		],
		"skills": [
			"./skills"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"typebox": "1.3.7",
		"typescript": "7.0.2",
		"vitest": "^4.1.10"
	}
}
