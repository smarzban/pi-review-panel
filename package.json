{
	"name": "pi-review-panel",
	"version": "0.3.0",
	"description": "Multi-model code review panel: the review-panel command and its agent skill",
	"license": "MIT",
	"author": "Saeed Marzban",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/smarzban/pi-review-panel.git"
	},
	"bugs": {
		"url": "https://github.com/smarzban/pi-review-panel/issues"
	},
	"homepage": "https://github.com/smarzban/pi-review-panel#readme",
	"keywords": [
		"pi-package",
		"pi",
		"code-review",
		"review-panel",
		"cli"
	],
	"type": "module",
	"engines": {
		"node": ">=26.0.0"
	},
	"bin": {
		"review-panel": "dist/src/cli/main.js"
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"prepack": "npm run build",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"check": "biome check .",
		"smoke:installed": "node scripts/smoke-installed.mjs"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "1.5.2"
	},
	"files": [
		"dist",
		"skills",
		"docs/configuration.md",
		"docs/cli.md",
		"LICENSE"
	],
	"pi": {
		"skills": [
			"./skills"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@earendil-works/pi-ai": "1.5.2",
		"@types/node": "26.6.6",
		"esbuild": "0.28.2",
		"rolldown": "1.2.2",
		"typescript": "7.0.2",
		"vitest": "4.1.10"
	}
}
